{
  "expo": {
    "name": "HeatRadar",
    "slug": "heatradar",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "heatradar",
    "icon": "./src/assets/brand/heatradar-icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blackicebell.heatradar",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.717353489884-2t3dq4je1mnrk580b6t00eaj8dbjq9pa"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.blackicebell.heatradar",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/brand/heatradar-icon.png",
        "backgroundColor": "#050608"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "3a104044-3efa-4f11-b822-c6c99c203de9"
      }
    },
    "owner": "blackicebell",
    "plugins": [
      "expo-font",
      "@react-native-google-signin/google-signin",
      "expo-web-browser"
    ]
  }
}
